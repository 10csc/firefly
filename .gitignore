# ── Python ──
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── 环境与密钥（禁止入库）──
.env
*.env
app/config.json
user_data/
app/data/
memory/data/
android/keystore/
android/local.properties

# ── 热更新（见 docs/热更新规范.md）──
# 私钥**必须**在仓库外（默认 ~/.firefly/hotupdate_key.pem）；这里再挡一道防手滑
*.pem
hotupdate_key*
# 构建区（基线 + serial 计数）与发布区（补丁产物）都不入库：
#   补丁是**产物**，归档在服务器 + release 附件；代码本体在 git（tag hot-<base>-<serial>）
.tmp_hotupdate/
hotupdate_dist/

# ── 公告通道（见 docs/公告通道规范.md）──
# /notice/ 是**运行期缓存**（PC 开发时 notice_root() = 仓库根/notice，与 /voice/ 同公式），
# 内容是"服务器下发内容的本地缓存"，可再生，不入库。
# ⚠️ 内容源在 notice_src/（人写、必须入库）—— 两个目录刻意不同名，别合并。
/notice/

# ── 构建产物 ──
build/
dist/
*.exe
android/build/
android/app/build/
android/.gradle/
android/sdk/
android/firefly.apk
android/app/src/main/python/backend/
# 安卓 assets 同样是 Gradle `syncFrontendAssets`（**Sync 类型**）生成的镜像，与上面 backend/ 同性质；
# 2026-10-03 R-11 解除跟踪。解除前已核查：66 个 tracked 文件**全部**能由 Sync 从
# app/static、app/assets 子集、server/frontend 三个文件、app/assets/voice 这四个源重新生成，
# 无一手工文件（工具 `_harden/r11_assets_ownership_check.py`）。
android/app/src/main/assets/

# ── 日志与临时 ──
*.log
*.bak
.claude/*.bak

# ── 外来资料（搜索下载，禁止入库）──
docs/搜索资料结果/
docs/设计/前端/截图/
downloads/
firefly_backup_*.bundle
firefly_keystore_backup_*/

# ── 封装/训练产物（3GB，禁止入库）──
